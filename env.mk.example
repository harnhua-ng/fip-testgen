# ==============================================================================
# env.mk.example — Machine-Specific Configuration Override Template
# ==============================================================================
# Copy this file to 'env.mk' (which is git-ignored) to override default paths
# and license settings for your specific machine or environment without
# modifying tracked repository files.
#
# Usage:
#   cp env.mk.example env.mk
# ==============================================================================

# ── Lattice Radiant Installation Path ─────────────────────────────────────────
# Windows default: C:/lscc/radiant/2026.1
# Linux default:   /opt/lscc/radiant/2026.1
# RADIANT_ROOT = C:/lscc/radiant/2026.1
# RADIANT_ROOT = /opt/lscc/radiant/2026.1

# ── Lattice & Questa License Servers ──────────────────────────────────────────
# Node-locked file or port@hostname
# LM_LICENSE_FILE     = C:/lscc/radiant/2026.1/license/license.dat
# LM_LICENSE_FILE     = 1850@ldc-virtlic02
# SALT_LICENSE_SERVER = 1717@lrd-virtlic-rh8-01:1717@lrd-virtlic-ha-01a:1717@lrd-virtlic-ha-01b
